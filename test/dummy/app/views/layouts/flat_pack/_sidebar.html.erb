<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Webhook Demo",
      subtitle: "Recording Studio"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Home",
        href: main_app.root_path,
        icon: :home
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Webhook endpoints",
        href: recording_studio_webhooks.admin_root_path,
        icon: :bolt
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Dummy webhook tester",
        href: main_app.dummy_webhook_tester_path,
        icon: :beaker
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Install",
        href: main_app.install_path,
        icon: :folder
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Config",
        href: main_app.config_path,
        icon: :cog
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Sidekiq",
        href: main_app.url_for("/sidekiq"),
        icon: :clock
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Recording tree",
        href: main_app.recording_tree_path,
        icon: :folder
      ) %>

    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Sign out",
        href: main_app.destroy_user_session_path,
        icon: :lock,
        class: "mx-0",
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>

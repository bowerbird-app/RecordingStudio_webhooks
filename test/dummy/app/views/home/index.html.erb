<% dummy_page_nav(title: "Inbound webhook demo", back_url: main_app.root_path) %>

<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Inbound webhook demo",
    subtitle: "A safe browser surface for Recording Studio Webhooks administration.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Secure intake",
          subtitle: "The engine accepts authenticated JSON inbound events only.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Endpoints attach to stable Recording Studio recordings.</li>
          <li>Tokens are hashed, rotated, and shown only once at issuance.</li>
          <li>Payloads are redacted before persistence and deduplicated safely.</li>
          <li>Registered actions are persisted as attempts before execution.</li>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Try the admin hierarchy",
          subtitle: "The dummy configuration permits only its seeded administrator.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ol class="space-y-3 text-sm leading-6 list-decimal pl-5">
          <li>Open Webhook endpoints from Admin webhooks.</li>
          <li>Create an endpoint for a seeded Recording Studio recording.</li>
          <li>Issue a token and copy it only from the immediate response.</li>
          <li>Use the sandbox with a sample JSON payload; it does not persist or execute anything.</li>
        </ol>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Provider registry",
          subtitle: "The dummy registers a non-networking demo provider and action.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <p class="text-sm leading-6 text-(--surface-content-color)">
          Submit <code>demo.received</code> to the sandbox to inspect deterministic matching, immutable policy snapshots, and redaction. The dummy dispatcher intentionally performs no work.
        </p>
      <% end %>

      <% card.footer do %>
        <%= render FlatPack::Button::Component.new(
          text: "Open webhook endpoints",
          style: :primary,
          size: :md,
          href: recording_studio_admin_webhooks_engine_path
        ) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Host installation",
          subtitle: "Use the install generator in a host application.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Add the gem to the host app and run <code>bundle install</code>.</li>
          <li>Run <code>rails generate recording_studio_webhooks:install</code>.</li>
          <li>Set an explicit admin authorizer and recording scope.</li>
          <li>Register providers and inbound actions in the generated initializer.</li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>

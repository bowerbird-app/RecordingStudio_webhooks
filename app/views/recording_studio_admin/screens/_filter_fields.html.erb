<% filters.each do |filter| %>
  <div class="<%= wrapper_class %>">
    <% if filter.type == :date_range %>
      <%= render FlatPack::DateRangeInput::Component.new(
        start_name: filter.start_param,
        end_name: filter.end_param,
        start_value: filter.value&.start_date,
        end_value: filter.value&.end_date,
        label: filter.key.to_s.humanize
      ) %>
      <%= hidden_field_tag filter.preset_param, filter.value&.preset_key %>
    <% else %>
      <% use_raw_option_label = filter.key.to_sym == :action_name || filter.param_key.to_sym == :action_name %>
      <% select_options = Array(filter.options[:values] || filter.options[:options]).map do |value|
           option_label = value.to_s
           option_label = option_label.humanize unless use_raw_option_label
           { label: option_label, value: value }
         end %>
      <% select_search_options = filter.options.slice(:searchable, :search_mode, :search_param, :search_endpoint).compact %>
      <% if select_options.any? %>
        <%= render FlatPack::Select::Component.new(
          name: filter.param_key,
          options: select_options,
          value: filter.value,
          label: filter.key.to_s.humanize,
          placeholder: "All",
          **select_search_options
        ) %>
      <% else %>
        <%= render FlatPack::SearchInput::Component.new(
          name: filter.param_key,
          value: filter.value,
          label: filter.key.to_s.humanize,
          placeholder: filter.key.to_s.humanize
        ) %>
      <% end %>
    <% end %>
  </div>
<% end %>

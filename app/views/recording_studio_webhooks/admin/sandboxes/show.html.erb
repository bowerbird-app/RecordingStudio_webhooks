<% content_for :title, "Webhook Sandbox" %>
<% content_for :subtitle, "Dry-run endpoint/provider resolution, signatures, parsing, and action attemptning without persistence or execution." %>
<% flat_pack_page_nav(round: true, style: :default, anchor_href: admin_webhooks_section_path, anchor_tooltip: "Close") %>

<% if @form_error.present? %>
  <%= render FlatPack::Alert::Component.new(description: @form_error, style: :danger) %>
<% end %>

<%
  default_headers_json = JSON.pretty_generate(
    {
      authorization: "Bearer rswh_example_token",
      "x-webhook-timestamp": Time.current.iso8601,
      "content-type": "application/json"
    }
  )
  default_payload_json = JSON.pretty_generate(
    {
      id: "evt_sample_123",
      type: "demo.received",
      data: {
        object: {
          id: "obj_123",
          status: "active"
        }
      }
    }
  )
  headers_value = params.dig(:sandbox, :headers_json).to_s.presence || default_headers_json
  payload_value = params.dig(:sandbox, :payload).to_s.presence || default_payload_json
%>

<% selected_provider = @selected_provider_name || params.dig(:sandbox, :provider_name).to_s %>
<% selected_endpoint = (@endpoint&.id || params.dig(:sandbox, :endpoint_id)).to_s %>

<%= render FlatPack::Card::Component.new do |card| %>
  <% card.body do %>
    <%= form_with url: admin_webhook_sandbox_path, scope: :sandbox, class: "space-y-4" do |_form| %>
      <%= render FlatPack::Grid::Component.new(cols: 2, gap: :md, align: :start) do %>
        <%= render FlatPack::Select::Component.new(
          name: "sandbox[provider_name]",
          label: "Provider",
          options: [["Select provider", ""]] + @providers.map { |provider| [provider.name, provider.name] },
          value: selected_provider,
          class: "w-full"
        ) %>
        <%= render FlatPack::Select::Component.new(
          name: "sandbox[endpoint_id]",
          label: "Endpoint (optional)",
          options: [["Auto-select first matching endpoint", ""]] + @endpoints.map { |endpoint| ["#{endpoint.provider_name} / #{endpoint.label}", endpoint.id] },
          value: selected_endpoint,
          class: "w-full"
        ) %>
      <% end %>
      <%= render FlatPack::TextInput::Component.new(
        name: "sandbox[event_type]",
        label: "Event type",
        value: params.dig(:sandbox, :event_type).to_s,
        required: false,
        placeholder: "invoice.paid"
      ) %>
      <%= render FlatPack::TextArea::Component.new(
        name: "sandbox[headers_json]",
        label: "Test headers JSON",
        value: headers_value,
        rows: 6,
        autogrow: false,
        placeholder: '{"authorization":"Bearer rswh_...","x-webhook-timestamp":"2026-07-29T00:00:00Z"}'
      ) %>
      <%= render FlatPack::TextArea::Component.new(
        name: "sandbox[payload]",
        label: "Sample JSON payload",
        value: payload_value,
        rows: 10,
        autogrow: false,
        required: true
      ) %>
      <%= render FlatPack::Button::Component.new(text: "Run dry-run validation", style: :primary, size: :md, type: "submit") %>
    <% end %>
  <% end %>
<% end %>

<% if @sandbox_result %>
  <% checks = @sandbox_result.fetch("checks") %>
  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg, align: :start) do %>
    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(title: "Resolution checks", variant: :h3, class: "mb-0 pb-0") %>
      <% end %>
      <% card.body do %>
        <%= render FlatPack::List::Component.new(layout: :key_value, divider: true) do %>
          <%= render FlatPack::List::Item.new(key: "Endpoint resolved") do %>
            <%= checks.fetch("endpoint_resolved") ? "yes" : "no" %>
          <% end %>
          <%= render FlatPack::List::Item.new(key: "Timestamp") do %>
            <%= checks.fetch("timestamp_valid") ? "valid" : "invalid" %> · <%= checks.fetch("timestamp_message") %>
          <% end %>
          <%= render FlatPack::List::Item.new(key: "Signature") do %>
            <%= checks.fetch("signature_verified") ? "verified" : "not verified" %> · <%= checks.fetch("signature_message") %>
          <% end %>
          <%= render FlatPack::List::Item.new(key: "Event extraction") do %>
            <%= checks.fetch("event_type") %>
          <% end %>
          <%= render FlatPack::List::Item.new(key: "Dispatcher") do %>
            <%= @sandbox_result.fetch("dispatcher") %>
          <% end %>
          <%= render FlatPack::List::Item.new(key: "Persistence") do %>
            disabled (dry-run only)
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::CodeBlock::Component.new(
      code: pretty_webhook_json(@sandbox_result.fetch("payload")),
      language: "json",
      title: "Redacted sample"
    ) %>

    <%= render FlatPack::Card::Component.new(border: :strong) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(title: "Matched actions", variant: :h3, class: "mb-0 pb-0") %>
      <% end %>
      <% card.body do %>
        <% actions = @sandbox_result.fetch("actions") %>
        <% if actions.any? %>
          <%= render FlatPack::List::Component.new(divider: true) do %>
            <% actions.each do |action| %>
              <%= render FlatPack::List::Item.new do %>
                <%= action.fetch("name") %>
                · <%= action.fetch("execution_mode") %>
                · retries: <%= action.fetch("max_retries") %>
                · source: <%= action.fetch("source") %>
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <%= render FlatPack::EmptyState::Component.new(
            title: "No matching actions",
            description: "No registered action matches this event type.",
            size: :sm,
            width: :full
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

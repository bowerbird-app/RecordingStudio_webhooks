<%= render FlatPack::PageTitle::Component.new(
  title: "Inbound events",
  subtitle: "Persisted payloads are redacted before storage.",
  variant: :h1
) %>

<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.body do %>
    <ul class="space-y-3">
      <% @events.each do |event| %>
        <li class="flex flex-wrap items-center justify-between gap-3 border-b pb-3">
          <div><strong><%= event.event_type %></strong><br><span class="text-sm"><%= event.received_at %> · <%= event.status %></span></div>
          <%= link_to "View", admin_endpoint_event_path(@endpoint, event) %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

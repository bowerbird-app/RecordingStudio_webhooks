<% content_for :title, "Inbound events" %>
<% flat_pack_page_nav(round: true, style: :default, anchor_href: admin_webhooks_section_path, anchor_tooltip: "Close") %>

<%= render FlatPack::Card::Component.new(border: :strong) do |card| %>
  <% card.body do %>
    <%= form_with url: params[:endpoint_id].present? ? admin_endpoint_events_path(@endpoint) : admin_events_path, method: :get, class: "grid gap-3 md:grid-cols-4" do |_form| %>
      <%= render FlatPack::Select::Component.new(
        name: "provider_name",
        label: "Provider",
        options: [["All", ""]] + @providers.map { |provider| [provider.name, provider.name] },
        value: @filter[:provider_name].to_s,
        class: "w-full"
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "endpoint_id",
        label: "Endpoint",
        options: [["All", ""]] + @endpoints.map { |endpoint| ["#{endpoint.provider_name} / #{endpoint.label}", endpoint.id] },
        value: @filter[:endpoint_id].to_s,
        class: "w-full"
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "endpoint_token",
        label: "Token",
        value: (@filter[:endpoint_token].presence || @filter[:endpoint_token_id]).to_s,
        placeholder: "rswh_..."
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "event_type",
        label: "Event type",
        value: @filter[:event_type].to_s,
        placeholder: "invoice.paid"
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "status",
        label: "Status",
        options: [["All", ""], ["accepted", "accepted"], ["planned", "planned"]],
        value: @filter[:status].to_s,
        class: "w-full"
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "execution_mode",
        label: "Mode",
        options: [["All", ""], ["parallel", "parallel"], ["sequential", "sequential"]],
        value: @filter[:execution_mode].to_s,
        class: "w-full"
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "from",
        label: "From",
        value: @filter[:from].to_s,
        placeholder: "YYYY-MM-DD HH:MM"
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "to",
        label: "To",
        value: @filter[:to].to_s,
        placeholder: "YYYY-MM-DD HH:MM"
      ) %>

      <div class="md:col-span-4">
        <%= render FlatPack::Button::Component.new(text: "Apply filters", style: :primary, size: :sm, type: "submit") %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if @events.any? %>
  <% rows = @events.map do |event|
       {
         title: "#{event.provider_name} · #{event.event_type}",
         received_at: event.received_at,
         status: event.status.to_s,
         endpoint: "#{event.endpoint.label} (#{event.endpoint.recording_studio_recording_id})",
         token: event.endpoint_token.attributes.fetch("token", nil).to_s.presence || "Unavailable",
         attempts: event.action_attempts.sum(&:attempts)
       }
     end %>
  <%= render FlatPack::Table::Component.new(data: rows, min_width: :none) do |table| %>
    <% table.column(title: "Event") { |row| row[:title] } %>
    <% table.column(title: "Received", html: ->(row) {
         render FlatPack::Timestamp::Component.new(timestamp: row[:received_at])
       }) %>
    <% table.column(title: "Status", html: ->(row) {
         render FlatPack::Badge::Component.new(
           text: row[:status],
           style: webhook_status_style(row[:status]),
           size: :sm
         )
       }) %>
    <% table.column(title: "Endpoint", wrap: :truncate, max_width: "14rem") { |row| row[:endpoint] } %>
    <% table.column(title: "Token", wrap: :truncate, max_width: "9rem") { |row| row[:token] } %>
    <% table.column(title: "Attempts", align: :end) { |row| row[:attempts].to_s } %>
  <% end %>
<% else %>
  <%= render FlatPack::EmptyState::Component.new(
    title: "No events",
    description: "No events match the current filters.",
    size: :sm,
    width: :full
  ) %>
<% end %>

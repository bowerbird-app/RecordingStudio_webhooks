<%= render FlatPack::PageNav::Component.new(
  anchor_url: admin_root_path,
  anchor_tooltip: "Close"
) %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <%= render FlatPack::PageTitle::Component.new(
    title: @provider.name,
    subtitle: "Provider-linked actions and endpoints.",
    variant: :h1
  ) %>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(title: "Actions", variant: :h3, class: "mb-0 pb-0") %>
    <% end %>
    <% card.body do %>
      <% if @matching_actions.any? %>
        <ul class="space-y-3 text-sm">
          <% @matching_actions.each do |action| %>
            <li class="border-b pb-3">
              <strong><%= action.name %></strong>
              <div class="text-xs text-gray-600">pattern: <%= action.event_pattern.value %> · source: <%= action.source %></div>
              <pre class="mt-2 overflow-auto rounded bg-black/5 p-3 text-xs"><%= pretty_webhook_json(action.policy_overrides) %></pre>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm">No actions are bound to this provider.</p>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(title: "Endpoints", variant: :h3, class: "mb-0 pb-0") %>
    <% end %>
    <% card.body do %>
      <% if @endpoints.any? %>
        <ul class="space-y-3 text-sm">
          <% @endpoints.each do |endpoint| %>
            <li class="flex items-center justify-between gap-3 border-b pb-3">
              <span><strong><%= endpoint.label %></strong> · recording <%= endpoint.recording_studio_recording_id %></span>
              <%= link_to "Open", admin_endpoint_path(endpoint) %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm">No endpoints exist for this provider.</p>
      <% end %>
    <% end %>
  <% end %>
</div>

<% content_for :title, "Providers" %>
<% content_for :subtitle, "Code-defined provider definitions and their endpoint footprint." %>
<% flat_pack_page_nav(round: true, style: :default, anchor_href: admin_webhooks_section_path, anchor_tooltip: "Close") %>

<% if @providers.any? %>
  <% rows = @providers.map do |provider|
       {
         name: provider.name,
         source: provider.source,
         endpoints: @provider_endpoint_counts.fetch(provider.name, 0),
         href: "/admin/screens/providers?#{ { provider: provider.name }.to_query }"
       }
     end %>
  <%= render FlatPack::Table::Component.new(data: rows, min_width: :sm) do |table| %>
    <% table.column(title: "Provider") { |row| row[:name] } %>
    <% table.column(title: "Source") { |row| row[:source] } %>
    <% table.column(title: "Endpoints") { |row| row[:endpoints].to_s } %>
    <% table.column(title: "Open", align: :end, html: ->(row) {
         render(FlatPack::Link::Component.new(href: row[:href])) { "Open" }
       }) %>
  <% end %>
<% else %>
  <%= render FlatPack::EmptyState::Component.new(
    title: "No providers",
    description: "No providers are registered.",
    size: :sm,
    width: :full
  ) %>
<% end %>

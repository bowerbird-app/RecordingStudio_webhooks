<%= render FlatPack::PageNav::Component.new(
  anchor_url: admin_root_path,
  anchor_tooltip: "Close"
) %>

<div class="flex items-center justify-between gap-4">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Endpoints",
    subtitle: "Managed endpoint identities under Admin Webhooks providers.",
    variant: :h1
  ) %>
  <div class="flex gap-2">
    <%= render FlatPack::Button::Component.new(text: "New endpoint", style: :primary, size: :md, url: new_admin_endpoint_path) %>
  </div>
</div>

<%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
  <% card.body do %>
    <%= form_with url: admin_endpoints_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
      <div>
        <label class="block text-sm font-medium" for="provider">Provider</label>
        <select id="provider" name="provider" class="mt-1 rounded border p-2 text-sm">
          <option value="">All providers</option>
          <% @providers.each do |provider| %>
            <option value="<%= provider.name %>" <%= "selected" if @selected_provider == provider.name %>><%= provider.name %></option>
          <% end %>
        </select>
      </div>
      <%= render FlatPack::Button::Component.new(text: "Apply", style: :secondary, size: :sm, type: "submit") %>
    <% end %>
  <% end %>
<% end %>

<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.body do %>
    <% if @endpoints.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr>
              <th class="p-2">Provider</th>
              <th class="p-2">Endpoint key</th>
              <th class="p-2">Recording</th>
              <th class="p-2">Status</th>
              <th class="p-2"></th>
            </tr>
          </thead>
          <tbody>
            <% @endpoints.each do |endpoint| %>
              <tr class="border-t">
                <td class="p-2"><%= endpoint.provider_name %></td>
                <td class="p-2 font-mono"><%= endpoint.identity_key %></td>
                <td class="p-2 font-mono text-xs"><%= endpoint.recording_studio_recording_id %></td>
                <td class="p-2">
                  <%= render FlatPack::Badge::Component.new(
                    text: endpoint.enabled? ? "enabled" : "disabled",
                    style: endpoint.enabled? ? :success : :warning,
                    size: :sm
                  ) %>
                </td>
                <td class="p-2 text-right">
                  <%= link_to "Provider", admin_provider_path(endpoint.provider_name) %>
                  ·
                  <%= link_to "Open", admin_endpoint_path(endpoint) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm">No endpoints are available for your Recording Studio recordings.</p>
    <% end %>
  <% end %>
<% end %>

<%= form_with model: @endpoint, url: @endpoint.persisted? ? admin_endpoint_path(@endpoint) : admin_endpoints_path, class: "space-y-5" do |form| %>
  <% if @form_error.present? || @endpoint.errors.any? %>
    <%= render FlatPack::Alert::Component.new(
      description: @form_error.presence || @endpoint.errors.full_messages.to_sentence,
      style: :danger
    ) %>
  <% end %>

  <% unless @endpoint.persisted? %>
    <% if respond_to?(:current_root_recording, true) && current_root_recording.present? %>
      <%= form.hidden_field :recording_studio_recording_id, value: current_root_recording.id %>
    <% else %>
      <%= render FlatPack::Alert::Component.new(
        description: "Select a root recording in the host app before creating endpoints.",
        style: :warning
      ) %>
    <% end %>

    <%= render FlatPack::Select::Component.new(
      name: "endpoint[provider_name]",
      label: "Provider",
      options: webhook_configuration.providers.all.map { |provider| [provider.name, provider.name] },
      value: @endpoint.provider_name.to_s,
      class: "w-full"
    ) %>

    <%= render FlatPack::TextInput::Component.new(
      name: "endpoint[label]",
      label: "Label",
      value: @endpoint.label,
      required: true,
      placeholder: "Billing Production",
      help_text: "Human-readable name used in the admin UI."
    ) %>

  <% end %>

  <% unless @endpoint.persisted? %>
    <%= hidden_field_tag "endpoint[enabled]", "0" %>
    <%= render FlatPack::Switch::Component.new(
      name: "endpoint[enabled]",
      label: "Accept inbound events",
      checked: @endpoint.enabled?
    ) %>

    <%= render FlatPack::Button::Component.new(
      text: "Create endpoint",
      style: :primary,
      size: :md,
      type: "submit",
      disabled: !respond_to?(:current_root_recording, true) || current_root_recording.blank?
    ) %>
  <% end %>
<% end %>

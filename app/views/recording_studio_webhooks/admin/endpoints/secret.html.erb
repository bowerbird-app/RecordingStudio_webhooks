<% content_for :head do %>
  <meta name="robots" content="noindex,nofollow">
<% end %>
<% content_for :title, "Copy this signing secret" %>
<% content_for :subtitle, "We show it once." %>

<%= render FlatPack::Card::Component.new(border: :strong) do |card| %>
  <% card.body do %>
    <%= render FlatPack::TextInput::Component.new(
      name: "signing_secret",
      label: "Signing secret",
      value: @signing_secret,
      quick_copy: true,
      help_text: "Use this to sign webhook requests. It will not be shown again."
    ) %>
  <% end %>
  <% card.footer do %>
    <%= render FlatPack::Button::Component.new(
      text: "Done",
      style: :primary,
      size: :md,
      href: "/admin/screens/endpoints"
    ) %>
  <% end %>
<% end %>

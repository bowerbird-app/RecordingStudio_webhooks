<%= render FlatPack::PageNav::Component.new(
  anchor_url: "#{main_app.recording_studio_admin_webhooks_path}/sections/admin_webhooks",
  anchor_tooltip: "Close"
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Edit #{@endpoint.label}",
  variant: :h1
) %>

<%= form_with model: @endpoint, url: admin_endpoint_path(@endpoint), class: "space-y-3", data: { turbo_action: "replace" } do |form| %>
  <% if @form_error.present? || @endpoint.errors.any? %>
    <%= render FlatPack::Alert::Component.new(
      description: @form_error.presence || @endpoint.errors.full_messages.to_sentence,
      style: :danger
    ) %>
  <% end %>

  <%= hidden_field_tag :auto_save, "1" %>
  <%= hidden_field_tag :return_to, request.fullpath %>

  <%= hidden_field_tag "endpoint[enabled]", "0" %>
  <div class="flex items-center">
    <label class="relative inline-flex items-center cursor-pointer">
      <input
        type="checkbox"
        name="endpoint[enabled]"
        value="1"
        class="sr-only peer"
        <%= "checked" if @endpoint.enabled? %>
        onchange="this.form.requestSubmit()"
      >
      <div
        class="pointer-events-none rounded-full transition-colors duration-200 h-6 w-11 bg-(--switch-track-background-color) peer-checked:bg-(--switch-track-checked-background-color) peer-focus-visible:ring-2 peer-focus-visible:ring-inset peer-focus-visible:ring-(--switch-focus-ring-color) peer-focus-visible:ring-offset-2"
        role="switch"
        aria-checked="<%= @endpoint.enabled? %>"
      ></div>
      <div class="pointer-events-none absolute left-0.5 top-0 rounded-full bg-(--switch-thumb-background-color) shadow-(--switch-thumb-shadow) transition-transform duration-200 translate-y-0.5 w-5 h-5 peer-checked:translate-x-5"></div>
    </label>
    <span class="ml-3 text-sm font-medium text-(--switch-label-color)">Accept inbound events</span>
  </div>

  <%= render FlatPack::TextInput::Component.new(
    name: "endpoint[label]",
    label: "Label",
    value: @endpoint.label,
    required: true
  ) %>
  <%= render FlatPack::TextInput::Component.new(
    name: "endpoint_url_status",
    label: "Active webhook URL",
    value: @endpoint_url.presence || "No active token URL available",
    quick_copy: @endpoint_url.present?,
    required: false,
    help_text: @endpoint_url.present? ? "Copy and paste this full URL into your provider webhook configuration." : "Issue a token to generate the active webhook URL."
  ) %>
  <%= render FlatPack::Button::Component.new(
    text: "Save",
    style: :primary,
    size: :sm,
    type: "submit"
  ) %>
<% end %>

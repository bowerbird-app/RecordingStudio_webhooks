<%= render FlatPack::PageNav::Component.new(
  anchor_url: "#{main_app.recording_studio_admin_webhooks_path}/sections/admin_webhooks",
  anchor_tooltip: "Close"
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Edit #{@endpoint.label}",
  variant: :h1
) %>

<%= form_with model: @endpoint, url: admin_endpoint_path(@endpoint), class: "space-y-3" do |form| %>
  <% if @form_error.present? || @endpoint.errors.any? %>
    <%= render FlatPack::Alert::Component.new(
      description: @form_error.presence || @endpoint.errors.full_messages.to_sentence,
      style: :danger
    ) %>
  <% end %>

  <%= hidden_field_tag :auto_save, "1" %>
  <%= render FlatPack::TextInput::Component.new(
    name: "endpoint[label]",
    label: "Label",
    value: @endpoint.label,
    required: true
  ) %>
  <%= render FlatPack::Button::Component.new(
    text: "Save",
    style: :primary,
    size: :sm,
    type: "submit"
  ) %>
<% end %>

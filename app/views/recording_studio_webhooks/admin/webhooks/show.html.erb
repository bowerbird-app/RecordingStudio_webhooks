<%= render FlatPack::PageNav::Component.new(
  anchor_url: main_app.root_path,
  anchor_tooltip: "Close"
) %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Admin Webhooks",
    subtitle: "Operational overview for providers, endpoints, intake activity, and execution behavior.",
    variant: :h1
  ) %>
  <div class="flex gap-2">
    <%= render FlatPack::Button::Component.new(text: "Providers", style: :secondary, size: :sm, url: admin_providers_path) %>
    <%= render FlatPack::Button::Component.new(text: "Endpoints", style: :secondary, size: :sm, url: admin_endpoints_path) %>
    <%= render FlatPack::Button::Component.new(text: "Incoming activity", style: :secondary, size: :sm, url: admin_events_path) %>
    <%= render FlatPack::Button::Component.new(text: "Webhook Sandbox", style: :primary, size: :sm, url: admin_webhook_sandbox_path) %>
  </div>
</div>

<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <p class="text-sm font-medium">Endpoint health</p>
      <p class="mt-2 text-2xl font-semibold"><%= @enabled_endpoint_count %>/<%= @endpoint_count %></p>
      <p class="text-xs text-gray-600">enabled / total · <%= @disabled_endpoint_count %> paused</p>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <p class="text-sm font-medium">Incoming events</p>
      <p class="mt-2 text-2xl font-semibold"><%= @event_count %></p>
      <p class="text-xs text-gray-600">accepted/planned events in scope</p>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <p class="text-sm font-medium">Execution pressure</p>
      <p class="mt-2 text-sm">Failures: <strong><%= @failed_plan_count %></strong></p>
      <p class="text-sm">Retries: <strong><%= @retrying_plan_count %></strong></p>
      <p class="text-sm">Blocked: <strong><%= @blocked_plan_count %></strong></p>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <p class="text-sm font-medium">Dispatcher health</p>
      <p class="mt-2 text-sm">Backend: <strong><%= @dispatcher_name %></strong></p>
      <p class="text-sm">Status:
        <%= render FlatPack::Badge::Component.new(
          text: (@dispatcher_healthy ? "healthy" : "degraded"),
          style: (@dispatcher_healthy ? :success : :warning),
          size: :sm
        ) %>
      </p>
    <% end %>
  <% end %>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(title: "Providers", variant: :h3, class: "mb-0 pb-0") %>
    <% end %>
    <% card.body do %>
      <% if @providers.any? %>
        <ul class="space-y-3 text-sm">
          <% @visible_providers.each do |provider| %>
            <li class="flex items-center justify-between gap-3 border-b pb-3">
              <span>
                <strong><%= provider.name %></strong>
                <span class="ml-2 text-xs text-gray-600">fingerprint <%= provider.fingerprint.first(12) %>…</span>
              </span>
              <%= link_to "Open", admin_provider_path(provider.name) %>
            </li>
          <% end %>
        </ul>
        <% if @providers.size > @visible_providers.size %>
          <p class="mt-4 text-sm"><%= link_to "View all", admin_root_path(show_all_providers: true) %></p>
        <% end %>
      <% else %>
        <p class="text-sm">No providers are registered.</p>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(title: "Actions", variant: :h3, class: "mb-0 pb-0") %>
    <% end %>
    <% card.body do %>
      <% if @actions.any? %>
        <ul class="space-y-3 text-sm">
          <% @visible_actions.each do |action| %>
            <li class="border-b pb-3">
              <strong><%= action.name %></strong>
              <div class="text-xs text-gray-600">provider: <%= action.provider_name || "any" %> · pattern: <%= action.event_pattern.value %></div>
            </li>
          <% end %>
        </ul>
        <% if @actions.size > @visible_actions.size %>
          <p class="mt-4 text-sm"><%= link_to "View all", admin_root_path(show_all_actions: true) %></p>
        <% end %>
      <% else %>
        <p class="text-sm">No actions are registered.</p>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.header do %>
    <%= render FlatPack::PageTitle::Component.new(title: "Incoming webhook activity", variant: :h3, class: "mb-0 pb-0") %>
  <% end %>
  <% card.body do %>
    <% if @recent_events.any? %>
      <ul class="space-y-3 text-sm">
        <% @recent_events.each do |event| %>
          <li class="flex flex-wrap items-center justify-between gap-2 border-b pb-3">
            <span><strong><%= event.provider_name %></strong> · <%= event.event_type %> · <%= event.received_at %></span>
            <%= link_to "Inspect", admin_endpoint_event_path(event.endpoint_id, event) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm">No inbound activity has been recorded.</p>
    <% end %>
  <% end %>
<% end %>

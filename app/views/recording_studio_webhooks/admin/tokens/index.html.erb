<% content_for :title, "Token history" %>
<% flat_pack_page_nav(round: true, style: :default, anchor_href: admin_webhooks_section_path, anchor_tooltip: "Close") %>

<% if @form_error.present? %>
  <%= render FlatPack::Alert::Component.new(description: @form_error, style: :danger) %>
<% end %>

<%= form_with url: admin_endpoint_tokens_path(@endpoint), scope: :endpoint_token, class: "mb-6 flex flex-wrap items-end gap-3" do |_form| %>
  <%= render FlatPack::DateTimeInput::Component.new(
    name: "endpoint_token[expires_at]",
    label: "Expiration (optional)"
  ) %>
  <%= render FlatPack::Button::Component.new(text: "Issue new token", style: :primary, size: :sm, type: "submit") %>
<% end %>

<% if @tokens.any? %>
  <% rows = @tokens.map do |token|
       state = if token.current?
                 ["active", :success]
               elsif token.revoked_at?
                 ["revoked", :danger]
               else
                 ["expired", :warning]
               end
       {
         token: token,
         label: token.attributes.fetch("token", nil).to_s.presence || "Unavailable",
         state_text: state.first,
         state_style: state.last,
         events: @events_by_token_id.fetch(token.id, 0)
       }
     end %>
  <%= render FlatPack::Table::Component.new(data: rows, min_width: :lg) do |table| %>
    <% table.column(title: "Token") { |row| row[:label] } %>
    <% table.column(title: "Issued", html: ->(row) {
         render FlatPack::Timestamp::Component.new(timestamp: row[:token].created_at)
       }) %>
    <% table.column(title: "Expires", html: lambda { |row|
         if row[:token].expires_at
           render FlatPack::Timestamp::Component.new(timestamp: row[:token].expires_at)
         else
           "Never"
         end
       }) %>
    <% table.column(title: "Revoked", html: lambda { |row|
         if row[:token].revoked_at
           render FlatPack::Timestamp::Component.new(timestamp: row[:token].revoked_at)
         else
           "-"
         end
       }) %>
    <% table.column(title: "State", html: ->(row) {
         render FlatPack::Badge::Component.new(text: row[:state_text], style: row[:state_style], size: :sm)
       }) %>
    <% table.column(title: "Logs") { |row| "#{row[:events]} event(s)" } %>
    <% table.column(title: "Revoke", align: :end, html: lambda { |row|
         token = row[:token]
         next unless token.current?

         render FlatPack::Button::Component.new(
           text: "Revoke",
           href: admin_endpoint_token_path(@endpoint, token),
           method: :delete,
           style: :danger,
           size: :sm
         )
       }) %>
  <% end %>
<% else %>
  <%= render FlatPack::EmptyState::Component.new(
    title: "No tokens",
    description: "Issue a token to give a provider a public intake URL.",
    size: :sm,
    width: :full
  ) %>
<% end %>

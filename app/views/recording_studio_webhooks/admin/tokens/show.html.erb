<% content_for :head do %>
  <meta name="robots" content="noindex,nofollow">
<% end %>
<% content_for :title, "Webhook endpoint ready" %>
<% content_for :subtitle, "Use this URL in your provider to start receiving inbound webhooks." %>

<%= render FlatPack::Card::Component.new(border: :strong) do |card| %>
  <% card.body do %>
    <%= render FlatPack::TextInput::Component.new(
      name: "endpoint_url",
      label: "Webhook endpoint URL",
      value: @endpoint_url,
      quick_copy: true,
      help_text: "Copy and paste this full URL into your provider webhook configuration."
    ) %>
  <% end %>
  <% card.footer do %>
    <%= render FlatPack::Button::Component.new(
      text: "Done",
      style: :primary,
      size: :md,
      href: admin_endpoint_path(@endpoint)
    ) %>
  <% end %>
<% end %>
